-- ============================================
-- VERIFY DATA
-- ============================================

-- Check Brands
SELECT * FROM vehicle_brands ORDER BY name;

-- Check Models with Brand names
SELECT 
    vm.id,
    vb.name as brand_name,
    vm.name as model_name
FROM vehicle_models vm
JOIN vehicle_brands vb ON vm.brand_id = vb.id
ORDER BY vb.name, vm.name;

-- Check Body Types with Brand names
SELECT 
    vbt.id,
    vb.name as brand_name,
    vbt.name as body_type_name
FROM vehicle_body_types vbt
JOIN vehicle_brands vb ON vbt.brand_id = vb.id
ORDER BY vb.name, vbt.name;

-- Count Models per Brand
SELECT 
    vb.name as brand_name,
    COUNT(vm.id) as model_count
FROM vehicle_brands vb
LEFT JOIN vehicle_models vm ON vb.id = vm.brand_id
GROUP BY vb.id, vb.name
ORDER BY model_count DESC;

-- Count Body Types per Brand
SELECT 
    vb.name as brand_name,
    COUNT(vbt.id) as body_type_count
FROM vehicle_brands vb
LEFT JOIN vehicle_body_types vbt ON vb.id = vbt.brand_id
GROUP BY vb.id, vb.name
ORDER BY body_type_count DESC;

-- ============================================
-- SAMPLE QUERIES FOR ADMIN DASHBOARD
-- ============================================

-- Get all models grouped by Brand (for dashboard)
SELECT 
    vb.name as brand_name,
    json_agg(vm.name ORDER BY vm.name) as models
FROM vehicle_brands vb
LEFT JOIN vehicle_models vm ON vb.id = vm.brand_id
GROUP BY vb.id, vb.name
ORDER BY vb.name;

-- Get all body types grouped by Brand
SELECT 
    vb.name as brand_name,
    json_agg(vbt.name ORDER BY vbt.name) as body_types
FROM vehicle_brands vb
LEFT JOIN vehicle_body_types vbt ON vb.id = vbt.brand_id
GROUP BY vb.id, vb.name
ORDER BY vb.name;

-- Get brand with its models and body types
SELECT 
    vb.name as brand_name,
    (SELECT json_agg(vm.name) FROM vehicle_models vm WHERE vm.brand_id = vb.id) as models,
    (SELECT json_agg(vbt.name) FROM vehicle_body_types vbt WHERE vbt.brand_id = vb.id) as body_types
FROM vehicle_brands vb
ORDER BY vb.name;


